---
import { SHIP_BRANDS } from "../lib/ships";
import { getShipProfile } from "../lib/ship-profiles";

interface Props {
  activeBrandId?: string;
}

const { activeBrandId } = Astro.props;
---

<section class="ship-picker" aria-label="船司甄选">
  <p class="ship-picker-lead">按邮轮品牌了解船型与设施，点击进入详细介绍。</p>
  <ul class="ship-picker-grid">
    {
      SHIP_BRANDS.map((b) => {
        const profile = getShipProfile(b.id);
        const hasDetail = Boolean(profile);
        return (
          <li>
            <a
              href={`/ships/${b.id}`}
              class:list={["ship-tile", { "has-profile": hasDetail, on: activeBrandId === b.id }]}
            >
              <span class="ship-tile-logo">
                <img src={b.logo} alt="" width="160" height="48" loading="lazy" />
              </span>
              <span class="ship-tile-text">
                <strong>{b.name}</strong>
                {b.nameEn && <span class="en">{b.nameEn}</span>}
              </span>
              <span class="ship-tile-cta">
                {hasDetail ? "查看船型" : "查看品牌"}
                <span class="chev" aria-hidden="true">›</span>
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .ship-picker {
    margin-bottom: var(--space-xl);
  }
  .ship-picker-lead {
    text-align: center;
    font-size: var(--font-size-sm);
    color: var(--sub);
    max-width: 32em;
    margin: 0 auto var(--space-lg);
    line-height: var(--line-height);
  }
  .ship-picker-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 12px;
    padding: 0;
  }
  .ship-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 28px 20px 22px;
    background: var(--surface);
    border-radius: var(--radius);
    text-decoration: none !important;
    color: inherit;
    transition:
      transform 0.35s var(--ease),
      background 0.35s var(--ease);
    position: relative;
    overflow: hidden;
  }
  .ship-tile::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px var(--line);
    pointer-events: none;
    transition: box-shadow 0.35s var(--ease);
  }
  .ship-tile:hover {
    transform: scale(1.02);
    background: #f5f5f7;
  }
  .ship-tile:hover::before {
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12);
  }
  .ship-tile:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }
  .ship-tile.has-profile .ship-tile-cta {
    color: var(--brand);
  }
  .ship-tile-logo {
    height: 52px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
  }
  .ship-tile-logo img {
    max-height: 44px;
    max-width: 150px;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: none;
    transition: transform 0.35s var(--ease);
  }
  .ship-tile:hover .ship-tile-logo img {
    transform: scale(1.04);
  }
  .ship-tile-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 12px;
  }
  .ship-tile-text strong {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .ship-tile-text .en {
    font-size: 14px;
    color: var(--sub);
    line-height: 1.35;
  }
  .ship-tile-cta {
    font-size: 15px;
    color: var(--sub);
    display: inline-flex;
    align-items: center;
    gap: 2px;
    margin-top: auto;
  }
  .chev {
    font-size: 18px;
    line-height: 1;
    transition: transform 0.25s var(--ease);
  }
  .ship-tile:hover .chev {
    transform: translateX(3px);
  }
</style>
