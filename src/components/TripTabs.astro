---
import type { Product } from "../types/product";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const tabs = [
  { id: "overview", label: "概览", content: product.overview ?? product.summary },
  { id: "highlight", label: "亮点", list: product.highlights },
  { id: "schedule", label: "日程", itinerary: product.itinerary },
  { id: "ship", label: "邮轮", content: product.ship },
  { id: "fee", label: "费用", content: product.feeNote },
  { id: "notice", label: "须知", content: product.notice },
];
---

<div class="trip-tabs" data-trip-tabs>
  <div class="tab-list" role="tablist">
    {tabs.map((t, i) => (
      <button
        type="button"
        role="tab"
        class:list={["tab", { on: i === 0 }]}
        data-tab={t.id}
        aria-selected={i === 0}
      >
        {t.label}
      </button>
    ))}
  </div>
  {tabs.map((t, i) => (
    <div
      class:list={["tab-panel", { on: i === 0 }]}
      data-panel={t.id}
      role="tabpanel"
      hidden={i !== 0}
    >
      {"list" in t && t.list && (
        <ul class="highlight-list">
          {t.list.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
      )}
      {"itinerary" in t && t.itinerary && (
        <ol class="itinerary">
          {t.itinerary.map((day) => (
            <li>
              <strong>第 {day.day} 天 · {day.title}</strong>
              <p>{day.content}</p>
            </li>
          ))}
        </ol>
      )}
      {"content" in t && t.content && <div class="prose" set:html={String(t.content).replace(/\n/g, "<br/>")} />}
    </div>
  ))}
</div>

<script>
  document.querySelectorAll("[data-trip-tabs]").forEach((root) => {
    const tabs = root.querySelectorAll<HTMLButtonElement>("[data-tab]");
    const panels = root.querySelectorAll<HTMLElement>("[data-panel]");
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const id = tab.dataset.tab;
        tabs.forEach((t) => {
          t.classList.toggle("on", t === tab);
          t.setAttribute("aria-selected", String(t === tab));
        });
        panels.forEach((p) => {
          const on = p.dataset.panel === id;
          p.classList.toggle("on", on);
          p.hidden = !on;
        });
      });
    });
  });
</script>

<style>
  .tab-list {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-md);
  }
  .tab {
    padding: 12px 18px;
    font-size: 17px;
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    color: var(--color-muted);
    cursor: pointer;
    margin-bottom: -1px;
  }
  .tab.on {
    color: var(--brand);
    font-weight: 600;
    border-bottom-color: var(--brand);
  }
  .tab-panel {
    font-size: var(--font-size-sm);
    line-height: var(--line-height);
    color: var(--color-text);
  }
  .highlight-list {
    padding-left: 1.25em;
  }
  .highlight-list li {
    margin-bottom: 10px;
  }
  .itinerary li {
    margin-bottom: var(--space-sm);
  }
  .itinerary p {
    margin-top: 6px;
    color: var(--color-muted);
  }
</style>
