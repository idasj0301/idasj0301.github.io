---
import { CATEGORIES } from "../lib/categories";
import { SITE } from "../lib/site";
---

<footer class="footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-brand">{SITE.name}</p>
      <p class="footer-desc">为您的生命旅程增添光彩</p>
    </div>
    <div>
      <p class="footer-col-title">选航线</p>
      {CATEGORIES.map((c) => (
        <a href={`${c.path}/`}>{c.label}</a>
      ))}
    </div>
    <div>
      <p class="footer-col-title">探索与工具</p>
      <a href="/calendar/">旅行日历</a>
      <a href="/trips/">全部航程</a>
      <a href="/articles/">船说·文章</a>
      <a href="/anniversary/">25 周年专题</a>
    </div>
    <div>
      <p class="footer-col-title">服务</p>
      <a href="/inquiry/">预约留咨</a>
      <a href="/advisor/">直连顾问</a>
      <a href="/advisor/" class="footer-qr" aria-label="查看船客旅行顾问二维码">
        <img src="/advisor-qr.png" alt="" width="80" height="80" loading="lazy" />
      </a>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© {new Date().getFullYear()} 船客 · 北京船客国际旅行社有限公司</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-primary);
    color: rgba(255, 255, 255, 0.9);
    padding: var(--space-lg) 0 var(--space-md);
    margin-top: var(--space-xl);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 1.2fr;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }
  .footer-brand {
    font-size: 20px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 8px;
  }
  .footer-desc {
    font-size: 16px;
    opacity: 0.85;
    line-height: 1.6;
  }
  .footer-col-title {
    font-weight: 700;
    color: #fff;
    margin-bottom: 12px;
    font-size: 17px;
  }
  .footer a {
    display: block;
    color: rgba(255, 255, 255, 0.88);
    font-size: 16px;
    margin-bottom: 8px;
    text-decoration: none;
  }
  .footer a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .footer-qr {
    width: 80px;
    height: 80px;
    margin-top: 12px;
    border-radius: 8px;
    display: block;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.9);
    padding: 4px;
  }
  .footer-qr img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 6px;
  }
  .footer-bottom {
    font-size: 14px;
    opacity: 0.7;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: var(--space-sm);
  }
  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
