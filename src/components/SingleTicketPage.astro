---
import type { Product } from "../types/product";
import { getProductDetail } from "../lib/product-details";
import { getCardSubtitle, getCardTitle, formatCardDateLine } from "../lib/product-card";

interface Props {
  products: Product[];
}

const { products } = Astro.props;
const todayIso = new Date().toISOString().slice(0, 10);
const activeProducts = products.filter((product) => product.departureDate >= todayIso);

const faqItems = [
  {
    question: "单船票和跟团产品有什么区别？",
    answer: "单船票通常只预订邮轮或探险船航段，适合已经自行安排国际机票、签证、前后段住宿或岸上行程的客人；跟团产品则会把更多陆地段、交通和领队服务打包在一起。",
  },
  {
    question: "单船票通常包含什么、不包含什么？",
    answer: "通常包含船上住宿、船上餐食、船上活动和船司安排的登陆或巡游项目；国际机票、签证、保险、出发前后酒店和额外岸上行程通常不包含，具体以船司条款和签约确认为准。",
  },
  {
    question: "适合哪些客人只订船票？",
    answer: "适合有较强自主出行能力、已安排国际段、希望灵活组合前后旅行，或已经明确想搭乘某家船司、某艘船、某个档期的客人。",
  },
  {
    question: "舱位和价格为什么要实时确认？",
    answer: "探险邮轮舱位数量有限，不同船司会随档期、舱型、促销政策和汇率变化调整价格。官网展示的是可咨询方向，最终余舱和报价需要顾问向船司实时确认。",
  },
  {
    question: "船客可以帮我比较哪些船司？",
    answer: "船客可协助比较庞洛、银海、夸克、66度、A21、SWAN、OW、信天翁、欧若拉等船司资源，并结合目的地、天数、预算、舱型偏好和出行经验给出建议。",
  },
  {
    question: "已经有机票和签证，能不能只订船票？",
    answer: "可以。你可以把已有机票、签证、计划出发月份和想去的目的地告诉顾问，顾问会优先按可衔接的船期和船司政策帮你筛选。",
  },
];

function productCompany(product: Product) {
  if (product.company) return product.company;
  if (product.shipName.includes("银海") || product.shipName.includes("Silver")) return "银海";
  if (product.shipName.includes("海神")) return "66度";
  if (product.shipName.includes("指挥官夏古")) return "庞洛";
  return "船客合作船司";
}

function productDestination(product: Product) {
  const text = `${product.title} ${product.summary} ${product.subcategory} ${(product.tags ?? []).join(" ")}`;
  if (text.includes("南极")) return "南极";
  if (text.includes("北极") || text.includes("格陵兰") || text.includes("斯瓦尔巴")) return "北极";
  if (text.includes("加拉帕戈斯")) return "加拉帕戈斯";
  return "其他";
}

function monthLabel(product: Product) {
  return `${new Date(`${product.departureDate}T12:00:00`).getMonth() + 1}月`;
}

function uniqueValues(values: string[]) {
  return [...new Set(values)].filter(Boolean);
}

const companyPriority = new Map([
  ["银海", 0],
  ["庞洛", 1],
  ["66度", 2],
]);

function toCardProduct(product: Product) {
  const detail = getProductDetail(product.slug);
  const company = productCompany(product);
  const destination = productDestination(product);
  const month = monthLabel(product);
  const days = `${product.durationDays}天`;
  const title = getCardTitle(product);
  const subtitle = getCardSubtitle(product);
  const dateLine = formatCardDateLine(product);
  const voyageCode = product.slug.startsWith("silversea-")
    ? product.slug.replace("silversea-", "").toUpperCase()
    : "";
  const displayTags = [...new Set(product.tags ?? [])]
    .filter((tag) => {
      if ([product.subcategory, product.shipName, company, "单船票"].includes(tag)) return false;
      return !product.shipName.includes(tag);
    })
    .slice(0, 2);

  return {
    product,
    company,
    title,
    subtitle,
    dateLine,
    displayTags,
    destination,
    month,
    days,
    voyageCode,
    keywords: [
      product.title,
      product.summary,
      product.shipName,
      product.subcategory,
      voyageCode,
      destination,
      month,
      ...(product.tags ?? []),
    ].join("|"),
    coverSrc: detail?.heroImage ?? detail?.gallery?.[0]?.src,
  };
}

function sortCards(a: ReturnType<typeof toCardProduct>, b: ReturnType<typeof toCardProduct>) {
  const rankA = companyPriority.get(a.company) ?? 9;
  const rankB = companyPriority.get(b.company) ?? 9;
  if (rankA !== rankB) return rankA - rankB;
  return a.product.departureDate.localeCompare(b.product.departureDate);
}

const silverseaProducts = activeProducts
  .filter((product) => product.slug.startsWith("silversea-"))
  .map(toCardProduct)
  .sort(sortCards);

const otherTicketProducts = activeProducts
  .filter((product) => !product.slug.startsWith("silversea-"))
  .map(toCardProduct)
  .sort(sortCards);

const officialFilterGroups = [
  { key: "month", label: "出发月份", options: uniqueValues(silverseaProducts.map((item) => item.month)) },
  { key: "days", label: "天数", options: uniqueValues(silverseaProducts.map((item) => item.days)) },
  { key: "company", label: "船司", options: uniqueValues(silverseaProducts.map((item) => item.company)) },
  { key: "ship", label: "船名", options: uniqueValues(silverseaProducts.map((item) => item.product.shipName.replace("银海", "").trim())) },
];
---

<article class="ticket-page">
  <section class="ticket-hero">
    <div class="ticket-hero-copy">
      <nav class="breadcrumb" aria-label="面包屑">
        <a href="/">首页</a> › <span>单船票</span>
      </nav>
      <p class="eyebrow">CRUISE ONLY · 船客单船票</p>
    </div>
  </section>

  <section class="ticket-section live-section" id="official-tickets" aria-label="单船票筛选">
    {
      silverseaProducts.length > 0 ? (
        <div data-product-filters>
          <div class="ticket-filter-panel product-filter-panel">
            <div class="filter-grid product-filter-grid">
              {
                officialFilterGroups.map((group) => (
                  <label>
                    <span>{group.label}</span>
                    <select data-product-filter-key={group.key}>
                      <option value="all">全部</option>
                      {group.options.map((option) => <option value={option}>{option}</option>)}
                    </select>
                  </label>
                ))
              }
              <label class="keyword-filter">
                <span>航次号 / 关键词</span>
                <input type="search" data-product-filter-key="keyword" placeholder="EV261020006" />
              </label>
            </div>
            <div class="filter-actions">
              <button type="button" class="filter-search" data-product-filter-submit>搜索</button>
              <button type="button" class="filter-reset" data-product-filter-reset>重置</button>
            </div>
          </div>

          <div class="official-ticket-grid">
            {
              silverseaProducts.map(({ product, company, title, subtitle, dateLine, displayTags, coverSrc, destination, month, days, voyageCode, keywords }, index) => (
                <article
                  class="official-ticket-card"
                  data-company={company}
                  data-destination={destination}
                  data-month={month}
                  data-days={days}
                  data-ship={product.shipName.replace("银海", "").trim()}
                  data-code={voyageCode}
                  data-keywords={keywords}
                >
                  <a
                    class="official-ticket-media"
                    href={`/trips/${product.slug}`}
                    aria-label={`查看${title}`}
                  >
                    {
                      coverSrc ? (
                        <img
                          src={coverSrc}
                          alt={product.imageAlt ?? title}
                          loading={index < 6 ? "eager" : "lazy"}
                          fetchpriority={index < 3 ? "high" : "auto"}
                          decoding="async"
                        />
                      ) : (
                        <span class="official-ticket-fallback" aria-hidden="true">{company}</span>
                      )
                    }
                    <span class="company-pill">{company}</span>
                    <span class="duration-pill">{product.durationDays}天</span>
                  </a>
                  <div class="official-ticket-body">
                    <div class="official-ticket-meta">
                      <span>{company}</span>
                      <small>{voyageCode || product.shipName}</small>
                    </div>
                    <h3><a href={`/trips/${product.slug}`}>{title}</a></h3>
                    <p class="official-ticket-date">{dateLine}</p>
                    {subtitle && <p class="official-ticket-subtitle">{subtitle}</p>}
                    {
                      displayTags.length > 0 && (
                        <div class="official-ticket-tags">
                          {displayTags.map((tag) => <span>{tag}</span>)}
                        </div>
                      )
                    }
                    <div class="official-ticket-footer">
                      <strong data-has-price={product.priceFrom > 0 ? "1" : "0"}>{product.priceLabel}</strong>
                      <a href={`/trips/${product.slug}/`}>查看详情</a>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
          <p class="filter-empty" data-product-filter-empty hidden>当前条件暂无正式 SKU，可调整筛选或直接提交需求。</p>
        </div>
      ) : (
        <p class="ticket-empty">当前没有可展示的在售单船票，请直连顾问获取最新航次。</p>
      )
    }
  </section>

  {otherTicketProducts.length > 0 && (
    <section class="ticket-section other-ticket-section" aria-label="其他单船票">
      <div class="compact-heading">
        <p>其他单船票</p>
        <h2>格陵兰与夏古号</h2>
      </div>
      <div class="official-ticket-grid compact-grid">
        {
          otherTicketProducts.map(({ product, company, title, subtitle, dateLine, displayTags, coverSrc, voyageCode }, index) => (
            <article class="official-ticket-card">
              <a class="official-ticket-media" href={`/trips/${product.slug}/`} aria-label={`查看${title}`}>
                {coverSrc && (
                  <img src={coverSrc} alt={product.imageAlt ?? title} loading={index < 2 ? "eager" : "lazy"} decoding="async" />
                )}
                <span class="company-pill">{company}</span>
                <span class="duration-pill">{product.durationDays}天</span>
              </a>
              <div class="official-ticket-body">
                <div class="official-ticket-meta">
                  <span>{company}</span>
                  <small>{voyageCode || product.shipName}</small>
                </div>
                <h3><a href={`/trips/${product.slug}/`}>{title}</a></h3>
                <p class="official-ticket-date">{dateLine}</p>
                {subtitle && <p class="official-ticket-subtitle">{subtitle}</p>}
                {displayTags.length > 0 && <div class="official-ticket-tags">{displayTags.map((tag) => <span>{tag}</span>)}</div>}
                <div class="official-ticket-footer">
                  <strong data-has-price={product.priceFrom > 0 ? "1" : "0"}>{product.priceLabel}</strong>
                  <a href={`/trips/${product.slug}/`}>查看详情</a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  )}

  <section class="ticket-section faq-section" aria-label="单船票常见问题">
    <div class="section-heading">
      <p>FAQ</p>
      <h2>单船票常见问题</h2>
    </div>
    <div class="faq-list">
      {
        faqItems.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="ticket-final-cta">
    <div>
      <p>已经有大致目的地或月份？</p>
      <h2>把你的时间、预算和想搭的船司告诉顾问</h2>
      <span>船客会按船司、航线、档期、舱位政策帮你缩小范围，再确认实时余舱与最终报价。</span>
    </div>
    <a href="/inquiry/?from=tickets-bottom" class="btn btn-primary">提交船票需求</a>
  </section>
</article>

<script>
  function initProductFilters() {
    document.querySelectorAll<HTMLElement>("[data-product-filters]").forEach((root) => {
      if (root.dataset.bound === "1") return;
      root.dataset.bound = "1";

      const cards = root.querySelectorAll<HTMLElement>(".official-ticket-card");
      const empty = root.querySelector<HTMLElement>("[data-product-filter-empty]");
      const count = root.querySelector<HTMLElement>("[data-product-filter-count]");
      const controls = root.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-product-filter-key]");
      const submit = root.querySelector<HTMLButtonElement>("[data-product-filter-submit]");
      const reset = root.querySelector<HTMLButtonElement>("[data-product-filter-reset]");

      function valueFor(card: HTMLElement, key: string) {
        if (key === "keyword") return (card.dataset.keywords ?? "").toLowerCase();
        return card.dataset[key] ?? "";
      }

      function apply() {
        let visible = 0;
        cards.forEach((card) => {
          const show = [...controls].every((control) => {
            const key = control.dataset.productFilterKey ?? "";
            const selected = control.value.trim();
            if (!selected || selected === "all") return true;
            const value = valueFor(card, key);
            if (key === "keyword") return value.includes(selected.toLowerCase());
            return value === selected;
          });
          card.hidden = !show;
          if (show) visible += 1;
        });
        if (count) count.textContent = `已显示 ${visible} 条`;
        if (empty) empty.hidden = visible !== 0;
      }

      submit?.addEventListener("click", apply);
      reset?.addEventListener("click", () => {
        controls.forEach((control) => {
          control.value = control instanceof HTMLSelectElement ? "all" : "";
        });
        apply();
      });
      controls.forEach((control) => {
        control.addEventListener("change", apply);
        control.addEventListener("input", () => {
          if (control instanceof HTMLInputElement) apply();
        });
        control.addEventListener("keydown", (event) => {
          if (event.key === "Enter") apply();
        });
      });
      apply();
    });
  }

  initProductFilters();
  document.addEventListener("astro:page-load", initProductFilters);
</script>

<style>
  .ticket-page {
    padding-bottom: var(--space-xl);
    background: #fbfbfd;
  }
  .ticket-hero,
  .ticket-section,
  .ticket-final-cta {
    width: min(100% - 2 * var(--page-pad), var(--max-width));
    margin: 0 auto;
  }
  .ticket-hero {
    display: grid;
    grid-template-columns: minmax(0, 920px);
    gap: 24px;
    align-items: end;
    padding: 24px 0 0;
  }
  .breadcrumb {
    margin-bottom: 18px;
    font-size: 15px;
    color: var(--sub);
  }
  .eyebrow,
  .section-heading p {
    margin: 0 0 10px;
    color: var(--brand);
    font-size: 13px;
    line-height: 1.4;
    font-weight: 600;
    letter-spacing: 0;
  }
  .ticket-section {
    padding: 38px 0;
  }
  .live-section {
    padding-top: 24px;
  }
  .official-ticket-card,
  .faq-list details {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
  }
  .faq-list p,
  .ticket-final-cta span {
    color: var(--sub);
    font-size: 16px;
    line-height: 1.68;
  }
  .section-heading {
    max-width: 780px;
    margin-bottom: 24px;
  }
  .section-heading h2,
  .ticket-final-cta h2 {
    margin: 0 0 12px;
    color: var(--ink);
    font-size: clamp(30px, 4vw, 48px);
    line-height: 1.12;
    font-weight: 600;
    letter-spacing: 0;
  }
  .route-heading {
    max-width: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 420px);
    gap: 24px;
    align-items: end;
  }
  .official-ticket-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .ticket-filter-panel {
    margin-bottom: 20px;
    padding: 14px 16px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 18px 60px rgba(0, 28, 58, 0.08);
    backdrop-filter: blur(18px);
  }
  .filter-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
  }
  .filter-grid label {
    min-width: 0;
  }
  .filter-grid span {
    display: block;
    margin-bottom: 5px;
    color: var(--sub);
    font-size: 12px;
    line-height: 1.35;
  }
  .filter-grid select,
  .filter-grid input {
    width: 100%;
    min-height: 38px;
    padding: 0 11px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 10px;
    background: #f5f5f7;
    color: var(--ink);
    font: inherit;
    font-size: 14px;
    outline: none;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
  }
  .filter-grid select:focus,
  .filter-grid input:focus {
    border-color: rgba(0, 113, 227, 0.55);
    box-shadow: 0 0 0 4px rgba(0, 113, 227, 0.12);
  }
  .filter-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 10px;
  }
  .filter-count {
    margin-right: auto;
    color: var(--sub);
    font-size: 14px;
  }
  .filter-actions button {
    min-height: 36px;
    padding: 0 16px;
    border-radius: 999px;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .filter-search {
    border: 1px solid #0071e3;
    background: #0071e3;
    color: #fff;
  }
  .filter-reset {
    border: 1px solid rgba(0, 0, 0, 0.08);
    background: #fff;
    color: var(--ink);
  }
  .compact-heading {
    margin-bottom: 18px;
  }
  .compact-heading p {
    margin: 0 0 7px;
    color: var(--brand);
    font-size: 13px;
    font-weight: 650;
  }
  .compact-heading h2 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(28px, 4vw, 42px);
    line-height: 1.14;
    font-weight: 650;
  }
  .official-ticket-meta,
  .official-ticket-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .official-ticket-meta span {
    color: var(--brand);
    font-size: 14px;
    font-weight: 600;
  }
  .official-ticket-footer a {
    font-size: 15px;
  }
  .filter-empty,
  .ticket-empty {
    grid-column: 1 / -1;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
    color: var(--sub);
    font-size: 16px;
    text-align: center;
  }
  .official-ticket-card {
    min-width: 0;
    overflow: hidden;
    display: flex;
    min-height: 100%;
    height: 100%;
    flex-direction: column;
  }
  .official-ticket-card[hidden] {
    display: none;
  }
  .official-ticket-media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #0d2f4f;
    color: #fff;
    text-decoration: none;
  }
  .official-ticket-media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
    transition: transform 0.35s var(--ease);
  }
  .official-ticket-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.05) 45%, rgba(0, 0, 0, 0.58) 100%);
    pointer-events: none;
  }
  .official-ticket-card:hover .official-ticket-media img {
    transform: scale(1.04);
  }
  .official-ticket-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: linear-gradient(145deg, #0d2f4f 0%, #1f6d72 55%, #d8a84f 100%);
    font-size: 28px;
    font-weight: 600;
  }
  .company-pill,
  .duration-pill {
    position: absolute;
    z-index: 1;
    bottom: 14px;
    max-width: calc(100% - 28px);
    padding: 6px 11px;
    border-radius: 980px;
    background: rgba(0, 0, 0, 0.42);
    color: #fff;
    font-size: 13px;
    line-height: 1.2;
    backdrop-filter: blur(8px);
  }
  .company-pill {
    left: 14px;
  }
  .duration-pill {
    right: 14px;
  }
  .official-ticket-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 18px;
  }
  .official-ticket-meta {
    min-width: 0;
    padding: 0 0 12px;
  }
  .official-ticket-meta small {
    min-width: 0;
    color: var(--sub);
    font-size: 13px;
    text-align: right;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .official-ticket-card h3 {
    margin: 0;
    color: var(--ink);
    font-size: 21px;
    line-height: 1.32;
    font-weight: 600;
    min-height: 56px;
  }
  .official-ticket-card h3 a {
    color: inherit;
    text-decoration: none;
  }
  .official-ticket-card h3 a:hover {
    color: var(--brand);
  }
  .official-ticket-date,
  .official-ticket-subtitle {
    margin: 9px 0 0;
    color: var(--sub);
    font-size: 14px;
    line-height: 1.45;
  }
  .official-ticket-subtitle {
    min-height: 40px;
  }
  .official-ticket-subtitle {
    margin-top: 6px;
  }
  .official-ticket-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 14px;
  }
  .official-ticket-tags span {
    max-width: 100%;
    padding: 5px 9px;
    border-radius: 980px;
    background: #f1f5f7;
    color: #45606d;
    font-size: 12px;
    line-height: 1.25;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
