---
/** 首页 Banner — 纯视觉轮播，文案由 KV 图承载；图片放 public/banner/ */
import { existsSync } from "node:fs";
import { join } from "node:path";

const bannerDir = join(process.cwd(), "public/banner");
const slideDefs = [
  {
    href: "/trips/2026-wangguin-antarctica-22d",
    file: "CLF_5650.jpg",
    alt: "南极冰川",
    fallback: "linear-gradient(135deg, #0c1929, #1b4965)",
  },
  {
    href: "/trips/2026-wangguin-antarctica-22d",
    file: "DSC_7726.jpg",
    alt: "王企鹅群落",
    fallback: "linear-gradient(135deg, #1b4965, #2a6f97)",
  },
  {
    href: "/trips/2026-wangguin-antarctica-22d",
    file: "CLF_3860.jpg",
    alt: "极地野生动物",
    fallback: "linear-gradient(135deg, #0d2818, #3d8b6e)",
    objectPosition: "center 62%",
  },
];
const slides = slideDefs
  .filter((s) => existsSync(join(bannerDir, s.file)))
  .map((s) => ({
    href: s.href,
    image: `/banner/${s.file}`,
    alt: s.alt,
    fallback: s.fallback,
    objectPosition: s.objectPosition ?? "center",
  }));
---

<section class="home-banner" aria-label="主推活动">
  <div class="banner" data-banner>
    {slides.length === 0 && (
      <a href="/trips" class="slide active" style="background: linear-gradient(135deg, #0c1929, #1b4965)" aria-label="船客航程" />
    )}
    {slides.map((s, i) => (
      <a
        href={s.href}
        class:list={["slide", { active: i === 0 }]}
        data-index={i}
        style={`background: ${s.fallback}`}
        aria-label={s.alt}
      >
        <img
          src={s.image}
          alt={s.alt}
          class="slide-img"
          style={`object-position: ${s.objectPosition}`}
          loading={i === 0 ? "eager" : "lazy"}
          onerror="this.style.display='none'"
        />
      </a>
    ))}
    {slides.length > 1 && (
      <div class="dots" role="tablist" aria-label="轮播指示">
        {slides.map((_, i) => (
          <button type="button" class:list={[{ on: i === 0 }]} data-dot={i} aria-label={`第 ${i + 1} 帧`} />
        ))}
      </div>
    )}
  </div>
</section>

<script>
  const root = document.querySelector("[data-banner]");
  if (root) {
    const slides = root.querySelectorAll(".slide");
    const dots = root.querySelectorAll("[data-dot]");
    if (slides.length >= 2) {
      let i = 0;
      const show = (n: number) => {
        i = (n + slides.length) % slides.length;
        slides.forEach((s, j) => s.classList.toggle("active", j === i));
        dots.forEach((d, j) => d.classList.toggle("on", j === i));
      };
      dots.forEach((d) =>
        d.addEventListener("click", () => show(Number((d as HTMLButtonElement).dataset.dot))),
      );
      setInterval(() => show(i + 1), 6000);
    }
  }
</script>

<style>
  .home-banner {
    width: 100%;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  .banner {
    position: relative;
    border-radius: 0;
    overflow: hidden;
    height: min(52vw, 520px);
    background: #0a2540;
    width: 100%;
  }
  .slide {
    position: absolute;
    inset: 0;
    display: none;
    text-decoration: none;
  }
  .slide.active {
    display: block;
  }
  .slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .dots {
    position: absolute;
    bottom: 18px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    gap: 8px;
  }
  .dots button {
    width: 8px;
    height: 8px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    cursor: pointer;
    padding: 0;
  }
  .dots button.on {
    background: #fff;
    width: 24px;
    border-radius: 4px;
  }
</style>
