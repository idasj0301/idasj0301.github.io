---
interface Props {
  priceLabel: string;
  advisorHref?: string;
  tripSlug?: string;
  tripTitle?: string;
}

const { priceLabel, advisorHref = "/advisor", tripSlug, tripTitle } = Astro.props;
const inquiryQs = new URLSearchParams();
if (tripSlug) inquiryQs.set("trip", tripSlug);
if (tripTitle) inquiryQs.set("title", tripTitle);
const inquiryHref = `/inquiry${inquiryQs.toString() ? `?${inquiryQs}` : ""}`;
---

<aside class="trip-cta" aria-label="预约咨询">
  <div class="trip-cta-inner">
    <div class="trip-cta-copy">
      <p class="trip-cta-price">{priceLabel}</p>
      <p class="trip-cta-sub">专属顾问 · 舱位说明与出行建议</p>
    </div>
    <div class="trip-cta-actions">
      <a href={inquiryHref} class="trip-cta-secondary">预约留咨</a>
      <a href={advisorHref} class="trip-cta-btn">联系顾问</a>
    </div>
  </div>
</aside>

<style>
  .trip-cta-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }
  .trip-cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 20px;
    font-size: 16px;
    font-weight: 500;
    color: var(--apple-link);
    background: #fff;
    border-radius: 980px;
    text-decoration: none !important;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .trip-cta-secondary:hover {
    background: #f5f5f7;
    text-decoration: none !important;
  }
  @media (max-width: 480px) {
    .trip-cta-inner {
      flex-wrap: wrap;
      min-height: 0;
      gap: 8px;
      padding: 10px 0 8px;
    }
    .trip-cta-copy {
      gap: 2px;
    }
    .trip-cta-price {
      font-size: 18px;
    }
    .trip-cta-sub {
      display: none;
    }
    .trip-cta-actions {
      width: 100%;
      justify-content: stretch;
    }
    .trip-cta-secondary,
    .trip-cta-btn {
      flex: 1;
      min-height: 44px;
      padding: 0 12px;
      font-size: 15px;
    }
  }
</style>
