---
import { wecomLink } from "../lib/wecom";

interface Props {
  from?: string;
  compact?: boolean;
}

const { from, compact = false } = Astro.props;
const link = wecomLink(from);
const primaryHref = link ?? "/advisor";
---

<aside class:list={["advisor-cta", { compact }]}>
  <p class="cta-title">直连旅行顾问</p>
  {!compact && (
    <p class="cta-desc">添加企业微信，获取航程推荐与出行建议。无需在线支付。</p>
  )}
  <a href={primaryHref} class="btn btn-primary" rel="noopener noreferrer">
    联系顾问
  </a>
  {link && <a href="/advisor" class="cta-secondary">查看二维码 ›</a>}
</aside>

<style>
  .advisor-cta {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-md);
    position: sticky;
    top: calc(var(--header-h) + 16px);
  }
  .cta-title {
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 12px;
  }
  .cta-desc {
    font-size: var(--font-size-sm);
    color: var(--color-muted);
    margin-bottom: var(--space-sm);
    line-height: 1.6;
  }
  .advisor-cta .btn {
    width: 100%;
    margin-bottom: 10px;
  }
  .cta-secondary {
    display: block;
    text-align: center;
    font-size: 16px;
  }
  .compact .cta-desc {
    display: none;
  }
</style>
