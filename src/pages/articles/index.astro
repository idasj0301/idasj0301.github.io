---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { articles } from "../../lib/products";
import { SITE } from "../../lib/site";

const list = articles.filter((a) => a.published);
---

<BaseLayout title={`船说 · 文章 · ${SITE.name}`} description="船客客人故事、极地手记与攻略文章。" path="/articles">
  <div class="container page">
    <header class="page-head">
      <p class="eyebrow">CHUANKE JOURNAL</p>
      <h1>船说 · 文章</h1>
      <p class="lead">客人故事、极地手记与出行攻略，帮您把远方的选择看清楚。</p>
    </header>
    <div class="list">
      {list.map((a, index) => (
        <a href={`/articles/${a.slug}/`} class:list={["item", { featured: index === 0 }]}>
          {a.image && (
            <img src={a.image} alt={a.imageAlt ?? a.title} width="800" height="450" loading={index < 3 ? "eager" : "lazy"} decoding="async" />
          )}
          <span class="item-copy">
            <span class="item-top">
              {a.tag && <span class="pill pill-gold">{a.tag}</span>}
              <span>{a.author}</span>
            </span>
            <h2>{a.title}</h2>
            <p>{a.excerpt}</p>
          </span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    padding: var(--space-md) 0 var(--space-xl);
  }
  .page-head {
    max-width: 760px;
    margin-bottom: 28px;
  }
  .eyebrow {
    color: var(--color-accent);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 8px;
  }
  h1 {
    font-size: clamp(34px, 4vw, 52px);
    line-height: 1.15;
    letter-spacing: 0;
  }
  .lead {
    color: var(--color-muted);
    font-size: 18px;
    line-height: 1.8;
    margin: 14px 0 0;
  }
  .list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }
  .item {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none !important;
    color: inherit;
    min-height: 100%;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .item:hover {
    transform: translateY(-3px);
    border-color: rgba(13, 61, 90, 0.22);
    box-shadow: 0 18px 42px rgba(15, 23, 42, 0.1);
  }
  .item img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: #e7eef3;
  }
  .item-copy {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 20px;
  }
  .item-top {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    color: var(--color-muted);
    font-size: 14px;
    margin-bottom: 12px;
  }
  .item h2 {
    font-size: 23px;
    line-height: 1.35;
    letter-spacing: 0;
    margin-bottom: 12px;
  }
  .item p {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-muted);
    margin-top: auto;
  }
  .featured {
    grid-column: span 2;
  }
  .featured h2 {
    font-size: clamp(28px, 3vw, 38px);
  }
  @media (max-width: 960px) {
    .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .list {
      grid-template-columns: 1fr;
    }
    .featured {
      grid-column: auto;
    }
    .item-copy {
      padding: 18px;
    }
  }
</style>
