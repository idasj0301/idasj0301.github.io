---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TripDetailRich from "../../components/TripDetailRich.astro";
import TripStickyCta from "../../components/TripStickyCta.astro";
import { getPublishedProducts, getProductBySlug } from "../../lib/products";
import { getProductDetail } from "../../lib/product-details";
import { getCategory } from "../../lib/categories";
import { productJsonLd, breadcrumbJsonLd } from "../../lib/geo";
import { SITE } from "../../lib/site";

export function getStaticPaths() {
  return getPublishedProducts().map((p) => ({
    params: { slug: p.slug },
  }));
}

const { slug } = Astro.params;
const product = getProductBySlug(slug!);
if (!product) return Astro.redirect("/trips");

const detail = getProductDetail(product.slug);
const cat = getCategory(product.category);
const title = `${product.title} · ${SITE.name}`;
const ld = [
  productJsonLd(product),
  breadcrumbJsonLd([
    { name: "首页", url: SITE.url },
    { name: cat?.label ?? "航程", url: `${SITE.url}${cat?.path ?? "/trips"}/` },
    { name: product.title, url: `${SITE.url}/trips/${product.slug}` },
  ]),
];
---

<BaseLayout
  title={title}
  description={product.summary}
  path={`/trips/${product.slug}`}
  jsonLd={ld}
  hideMobileBar
>
  <nav class="breadcrumb container">
    <a href="/">首页</a> ›
    <a href={cat ? `${cat.path}/` : "/trips/"}>{cat?.label}</a> ›
    <span>{product.title}</span>
  </nav>
  <TripDetailRich product={product} detail={detail} />
  <TripStickyCta
    priceLabel={product.priceLabel}
    tripSlug={product.slug}
    tripTitle={product.title}
  />
</BaseLayout>

<style>
  .breadcrumb {
    font-size: 17px;
    color: var(--sub);
    padding-top: 16px;
  }
</style>
