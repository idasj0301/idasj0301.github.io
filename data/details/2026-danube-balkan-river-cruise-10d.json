  "highlightSections": [
    {
      "title": "秋色多瑙河",
      "content": "九月底至十月初的多瑙河谷进入金黄、橙红与琥珀色交织的季节，河水、古堡与山谷秋光相映，是东欧河轮最适合慢赏的时段之一。",
      "image": {
        "src": "/trips/2026-danube-balkan-river-cruise-10d/highlight-01.jpg",
        "alt": "秋色多瑙河"
      }
    },
    {
      "title": "一船串联巴尔干五国",
      "content": "航线一船畅游罗马尼亚、保加利亚、塞尔维亚、克罗地亚与匈牙利，从古堡、要塞、老城到皇家王城，一站式读懂东欧千年更迭。",
      "image": {
        "src": "/trips/2026-danube-balkan-river-cruise-10d/highlight-02.jpg",
        "alt": "多瑙河五国航线"
      }
    },
    {
      "title": "久尔久 · 友谊大桥下的多瑙河明珠",
      "content": "久尔久坐落于多瑙河左岸，曾因连接布加勒斯特的铁路成为东方快车的重要停靠地。友谊大桥横跨多瑙河，将罗马尼亚与保加利亚紧密相连。",
      "image": {
        "src": "/trips/2026-danube-balkan-river-cruise-10d/gallery-01.jpg",
        "alt": "久尔久与多瑙河"
      }
    },
    {
      "title": "鲁塞 · 多瑙河畔的小维也纳",
      "content": "鲁塞以新巴洛克与新洛可可风格建筑、宽阔林荫大道和广场闻名，歌剧院、司法宫、自由广场与自由大桥共同构成保加利亚重要河港的城市气质。",
      "image": {
        "src": "/trips/2026-danube-balkan-river-cruise-10d/gallery-02.jpg",
        "alt": "鲁塞城市风光"
      }
    },
    {
      "title": "维丁 · 千年历史与多元文化",
      "content": "维丁拥有古罗马根基和奥斯曼时代记忆，老城区融合多种建筑风格，东正教堂、犹太会堂、清真寺与巴巴维达堡垒交织出边境城市的厚重层次。",
      "image": {
        "src": "/trips/2026-danube-balkan-river-cruise-10d/gallery-03.jpg",
        "alt": "维丁与巴巴维达堡垒"
      }
    },
    {
      "title": "克拉多沃 · 图拉真大桥的故乡",
      "content": "克拉多沃位于塞尔维亚东部，多瑙河畔的古老历史与现代休闲并存。这里曾是罗马皇帝图拉真建造传奇多瑙河大桥的地方，也保留着戴安娜堡垒等古迹。",
      "image": {
        "src": "/trips/2026-danube-balkan-river-cruise-10d/highlight-03.jpg",
        "alt": "克拉多沃与多瑙河峡谷"
      }
    },
    {
      "title": "铁门峡谷 · 地质瑰宝与生态天堂",
      "content": "多瑙河穿过喀尔巴阡山脉与巴尔干山脉之间的峡谷，峭壁高耸于河面之上，是整条航线最具震撼力的自然景观之一。",
      "image": {
        "src": "/trips/2026-danube-balkan-river-cruise-10d/highlight-03.jpg",
        "alt": "铁门峡谷"
      }
    },
    {
      "title": "贝尔格莱德 · 东欧的心脏",
      "content": "塞尔维亚首都贝尔格莱德位于多瑙河与萨瓦河交汇处，圣萨瓦大教堂、尼古拉·特斯拉博物馆和卡莱梅格丹堡垒共同呈现城市在历史中的重生。",
      "image": {
        "src": "/trips/2026-danube-balkan-river-cruise-10d/gallery-02.jpg",
        "alt": "贝尔格莱德"
      }
    },
    {
      "title": "武科瓦尔与布达佩斯",
      "content": "在克罗地亚武科瓦尔理解水塔下的不屈之城，最终抵达多瑙河明珠布达佩斯，渔人堡、国会大厦、英雄广场与温泉文化为河轮旅程收尾。",
      "image": {
        "src": "/trips/2026-danube-balkan-river-cruise-10d/hero.jpg",
        "alt": "布达佩斯与多瑙河"
      }
    },
    {
      "title": "Riverside 顶奢河轮体验",
      "content": "Riverside 以全套房私域、24 小时管家服务、精致餐饮和深度文化体验为核心。德彪西号提供 55 间全套房，船上餐饮、观景与舒适度是这条线的重要卖点。",
      "image": {
        "src": "/trips/2026-danube-balkan-river-cruise-10d/ship.jpg",
        "alt": "Riverside 德彪西号"
      }
    }
  ],
