# 企业微信获客链接（部署时必填）
PUBLIC_WECOM_URL=https://work.weixin.qq.com/ca/xxxx

# 正式域名（与 astro.config.mjs site 一致）
# SITE=https://www.chuanke.com

# 官网表单提交入口。正式部署使用后端中转，不要把企业微信 Webhook 写进前端。
PUBLIC_LEAD_ENDPOINT=/api/lead

# 企业微信智能表格 Webhook，只放服务器环境变量，不要提交到前端代码。
# WECOM_SMARTSHEET_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/wedoc/smartsheet/webhook?key=xxxx

# 后端中转服务生成行程链接时使用。
# PUBLIC_SITE_URL=https://www.chuanke.com
